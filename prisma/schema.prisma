// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  widgetLayout Json?
  createdAt    DateTime @default(now())

  sessions          Session[]
  trelloAccount     TrelloAccount?
  uptimeKumaConfig  UptimeKumaConfig?
  ntfySubscriptions NtfySubscription[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TrelloAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  boardId   String?
  boardName String?
  listId    String?
  listName  String?
  updatedAt DateTime @updatedAt
}

model UptimeKumaConfig {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseUrl   String
  slug      String
  updatedAt DateTime @updatedAt
}

model NtfySubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverUrl String
  topic     String
  token     String?
  createdAt DateTime @default(now())

  // Unix seconds; messages at or before this were cleared with "Clear all".
  clearedBefore Int?
  readMessages  NtfyReadMessage[]

  @@unique([userId, serverUrl, topic])
}

model NtfyReadMessage {
  subscriptionId String
  subscription   NtfySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  messageId      String
  messageTime    Int

  @@id([subscriptionId, messageId])
}
